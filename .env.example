# Referência; não copie este arquivo para .env.
# pnpm run setup gera .env ignorado com credenciais próprias e portas livres.
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=43124
# FRONTEND_URL=http://127.0.0.1:43123
# PROFILE=public
# DATABASE_URL e MIGRATION_DATABASE_URL são geradas com papéis diferentes.
# Para executar a coleta, preencha os valores abaixo apenas em .env local.
# MIGRATION_DATABASE_URL usa o papel de escrita; nunca o exponha no frontend.
# MIGRATION_DATABASE_URL=postgresql://renova_migrator:senha@127.0.0.1:5432/banco
# LINX_URL=https://webapi.microvix.com.br/1.0/api/integracao
# LINX_COLLECTION=./secrets/MiniSo - Linx.json
# LINX_USER=
# LINX_PASSWORD=
# LINX_KEY=
# LINX_PORTAL=18376
