{
  "name": "@renova/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/material-symbols-outlined": "5.3.9",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
