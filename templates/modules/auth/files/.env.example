# Referência; não copie este arquivo para .env.
# pnpm run setup gera .env ignorado com credenciais próprias e portas livres.
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=43124
# FRONTEND_URL=http://127.0.0.1:43123
# PROFILE=authenticated
# DATABASE_URL e MIGRATION_DATABASE_URL são geradas com papéis diferentes.
# Nenhuma credencial de serviço externo é necessária para desenvolver localmente.

# Somente no perfil com login; setup gera os valores, não preencha manualmente.
# AUTH_SECRET: segredo exclusivo do projeto (nunca expor ao frontend).
# SMTP_HOST=127.0.0.1
# SMTP_PORT e MAILPIT_PORT: portas locais livres da caixa de desenvolvimento.
# AUTH_EMAIL_FROM=acesso@renova.local
# Produção usa variáveis próprias no Railway; consulte docs/process/railway.md.
